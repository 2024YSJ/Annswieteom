# Cloudflare Tunnel 설정 파일 예시
# 실제 파일은 %USERPROFILE%\.cloudflared\config.yml 에 저장한다 (저장소에 커밋하지 않는다)
#
# 설정 방법:
#   1. cloudflared.exe tunnel login
#   2. cloudflared.exe tunnel create annswieoteum-llm
#      -> <TUNNEL_ID>.json 이 %USERPROFILE%\.cloudflared\ 에 생성됨
#   3. 아래 내용을 %USERPROFILE%\.cloudflared\config.yml 로 저장하고
#      <TUNNEL_ID>, <사용자명>, <서브도메인>, <도메인> 을 실제 값으로 교체

tunnel: annswieoteum-llm
credentials-file: C:\Users\<사용자명>\.cloudflared\<TUNNEL_ID>.json

ingress:
  - hostname: llm.<도메인>       # 예: llm.example.com
    service: http://localhost:11434
  - service: http_status:404
