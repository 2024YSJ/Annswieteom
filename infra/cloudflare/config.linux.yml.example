# Cloudflare Tunnel 설정 파일 예시 — Linux 추론 서버(DGX Spark, aarch64)
#
# 실제 파일은 /etc/cloudflared/config.yml 에 저장한다 (저장소에 커밋하지 않는다).
# systemd 서비스가 사용자 홈에 의존하지 않도록 자격증명도 /etc/cloudflared/ 로 옮긴다.
#
# 설정 방법 (전체 절차는 docs/checklists/person_A_infra_ai/08_dgx_spark_migration.md):
#   1. curl -fsSL -o /tmp/cloudflared.deb \
#        https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64.deb
#      sudo dpkg -i /tmp/cloudflared.deb
#      ^ arm64 빌드여야 한다. x86 바이너리는 DGX Spark에서 실행되지 않는다.
#   2. cloudflared tunnel login
#   3. cloudflared tunnel create annswieteom-llm-spark
#      -> <TUNNEL_ID>.json 이 ~/.cloudflared/ 에 생성됨
#   4. sudo mkdir -p /etc/cloudflared
#      sudo cp ~/.cloudflared/<TUNNEL_ID>.json /etc/cloudflared/
#   5. 이 내용을 /etc/cloudflared/config.yml 로 저장하고 <TUNNEL_ID>를 실제 값으로 교체
#   6. cloudflared tunnel route dns --overwrite-dns annswieteom-llm-spark llm.annswieteom.com
#      ^ 이 호스트명은 이미 옛 터널을 가리키고 있으므로 --overwrite-dns 가 필요하다.
#        그리고 DNS는 반드시 "터널 ID"를 가리켜야 한다 — 대시보드의 계정 ID나
#        커넥터 ID와 생김새가 비슷해서 실제로 두 번 헷갈렸고 에러 1033을 봤다.
#   7. sudo cloudflared --config /etc/cloudflared/config.yml service install
#      sudo systemctl enable --now cloudflared
#      journalctl -u cloudflared -n 50 --no-pager
#      ^ systemctl 이 active 라고 표시하는 것만으로는 터널이 살아 있다는 증거가 아니다.
#        로그에 커넥션이 등록되는 것과, 외부에서 fresh curl 로 응답이 오는 것을 둘 다 본다.
#
# Ollama 쪽 준비 (같은 문서 2절):
#   sudo snap set ollama host="0.0.0.0:11434"   # DGX Spark의 Ollama는 snap이라
#   sudo snap restart ollama                    # systemctl edit ollama 가 먹지 않는다
#
# Cloudflare Access:
#   이 터널은 Access 서비스 토큰 뒤에 둔다(같은 문서 7절). 그래서 토큰 없는 요청은
#   200이 아니라 403이 정상이다. 백엔드는 LLM_ACCESS_CLIENT_ID / LLM_ACCESS_CLIENT_SECRET
#   환경변수로 CF-Access-Client-Id / CF-Access-Client-Secret 헤더를 붙인다.

tunnel: annswieteom-llm-spark
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  - hostname: llm.annswieteom.com
    service: http://localhost:11434
    originRequest:
      httpHostHeader: localhost:11434   # 필수: 없으면 Ollama가 터널 도메인을 Host 헤더로 받아 403 Forbidden 반환
  - service: http_status:404
