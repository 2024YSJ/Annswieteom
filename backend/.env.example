# development (local) or production (Railway) - controls refresh-token cookie
# SameSite/Secure flags, see person_B_frontend_backend/01_auth.md
ENVIRONMENT=development

# Comma-separated frontend origins allowed to call this API (CORS).
# Local dev only needs localhost:3000. In Railway, add the deployed
# Vercel domains, e.g.:
# CORS_ALLOW_ORIGINS=https://annswieteom.com,https://www.annswieteom.com,https://annswieteom.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT
JWT_SECRET=replace_with_32byte_hex_from_openssl_rand_hex_32
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# Local LLM (Ollama)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL_NAME=qwen2.5:14b

# Gemini fallback

# Provider order (comma-separated)

# Supabase Storage (for image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=records

# 워크넷(고용24) Open API — https://www.work24.go.kr 회원가입 후 신청,
# 담당자 심사를 거쳐 발급(무료, 신청 즉시 발급은 아님). 카테고리마다 별도
# 신청/승인이 필요하고 키도 서로 다르다(2026-09-08 devlog 15/16 참고).
# "취업 정보 종합 검색" 기능이 실제로 쓰는 6개 — 채용정보(구인정보 검색
# 자체는 개인회원 차단이지만 같은 신청으로 딸려오는 채용행사/공채속보/
# 공채기업정보 3개는 정상 작동)와 훈련과정 4종 중 하나, 구직자취업역량
# 강화프로그램, 강소기업.
WORKNET_JOB_POSTING_API_KEY=your_worknet_job_posting_api_key
WORKNET_EMPLOYER_TRAINING_API_KEY=your_worknet_employer_training_api_key
WORKNET_CONSORTIUM_TRAINING_API_KEY=your_worknet_consortium_training_api_key
WORKNET_WORK_STUDY_TRAINING_API_KEY=your_worknet_work_study_training_api_key
WORKNET_TOMORROW_LEARNING_CARD_API_KEY=your_worknet_tomorrow_learning_card_api_key
WORKNET_JOB_SEEKER_PROGRAM_API_KEY=your_worknet_job_seeker_program_api_key
WORKNET_PROMISING_SME_API_KEY=your_worknet_promising_sme_api_key

# 온통청년(youthcenter.go.kr) 청년정책 통합 Open API - 회원가입 후
# [마이페이지 - OPEN API]에서 신청, 담당자 승인 후 발급(무료).
# 비워두면 청년정책 소스만 조용히 빠지고 나머지 피드는 정상 동작한다.
YOUTHCENTER_API_KEY=your_youthcenter_api_key
